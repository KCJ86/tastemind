# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override the default model (claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# Voyage AI (embeddings for RAG) — optional; without it the app falls back to recent visits
VOYAGE_API_KEY=your_voyage_api_key_here

# Google Maps (Places API (New) + Geocoding API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@host:port/railway
# Set to true when connecting over SSL (e.g. Railway's DATABASE_PUBLIC_URL)
DATABASE_SSL=false

# App
PORT=3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
